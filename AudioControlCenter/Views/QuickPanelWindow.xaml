<Window x:Class="BTAudioSwitcher.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BT Audio Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="360"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="16" Margin="8"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel Margin="16,14">

            <!-- 标题 + 完整面板入口 -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="BT Audio Switcher" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="完整面板 ›" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Right"
                        Click="OpenFull_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 最近设备：一键连接/断开 -->
            <TextBlock Text="最近设备" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding RecentQuickDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}" Click="QuickDevice_Click" Margin="0,0,8,8" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource ComboBgBrush}" CornerRadius="10" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0"
                                                    Background="{Binding BrandColor, Converter={StaticResource HexColorConverter}}">
                                                <TextBlock Text="{Binding BrandInitial}" Foreground="White" FontWeight="Bold"
                                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" MaxWidth="150"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 默认输出/输入 -->
            <TextBlock Text="默认设备" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔊 输出" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}" ItemsSource="{Binding RenderDevices}"
                          SelectedItem="{Binding SelectedDefaultOutput, Mode=TwoWay}"
                          ItemTemplate="{StaticResource DeviceItemTemplate}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🎙️ 输入" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}" ItemsSource="{Binding CaptureDevices}"
                          SelectedItem="{Binding SelectedDefaultInput, Mode=TwoWay}"
                          ItemTemplate="{StaticResource DeviceItemTemplate}"/>
            </Grid>

            <!-- 全局音量 -->
            <TextBlock Text="全局音量" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="VolumeText" Grid.Column="1" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                           MinWidth="46" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
