<UserControl x:Class="AudioControlCenter.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AudioControlCenter.Models"
             MinWidth="560">
    <UserControl.Resources>

        <!-- 应用行卡片（系统音量合成器样式） -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:AppSessionItem}">
            <Border Background="#26282F" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 行1：图标 + 名称 + 静音 + 音量滑块 + 百分比 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#33363F"
                                Margin="0,0,10,0">
                            <Image Width="24" Height="24" Stretch="Uniform">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource IconConverter}">
                                        <Binding Path="IconPath"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FollowStateText}" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="2" Click="MuteButton_Click" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="静音/取消静音" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔊"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Text" Value="🔇"/>
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <Slider Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SliderStyle}"
                                    ValueChanged="SessionVolume_ValueChanged"
                                    Tag="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" Width="40" TextAlignment="Right"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 行2：输出/输入设备下拉 + 恢复默认 -->
                    <Grid Grid.Row="1" Margin="42,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="输出" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox x:Name="OutputCombo" Style="{StaticResource ComboStyle}" SelectionChanged="SessionOutput_SelectionChanged"
                                      Tag="{Binding}" Loaded="SessionCombo_Loaded">
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="跟随默认"/>
                                        <CollectionContainer Collection="{Binding DataContext.RenderDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="输入" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox x:Name="InputCombo" Style="{StaticResource ComboStyle}" SelectionChanged="SessionInput_SelectionChanged"
                                      Tag="{Binding}" Loaded="SessionCombo_Loaded">
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="跟随默认"/>
                                        <CollectionContainer Collection="{Binding DataContext.CaptureDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="3" Content="恢复默认" Click="ResetSession_Click" Tag="{Binding}"
                                Style="{StaticResource PillButtonStyle}" Background="#33424750"
                                VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 蓝牙设备卡片 -->
        <DataTemplate x:Key="BtTemplate" DataType="{x:Type models:BluetoothDeviceItem}">
            <Border Background="#26282F" CornerRadius="12" Padding="12,10" Margin="0,0,8,8" MinWidth="150">
                <StackPanel Width="150">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="140" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BatteryText}" FontSize="11" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowBattery}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{Binding ConnectButtonText}" Click="BtToggle_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanToggle}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TogglePillStyle}">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TextTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- BLE 扫描结果卡片 -->
        <DataTemplate x:Key="ScanTemplate" DataType="{x:Type models:ScanDeviceItem}">
            <Border Background="#26282F" CornerRadius="10" Padding="10,8" Margin="0,0,8,8" MinWidth="150">
                <StackPanel Width="150">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    <TextBlock Text="{Binding MacText}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Margin="0,2,0,6"/>
                    <Button Content="{Binding PairButtonText}" Click="PairScan_Click" Tag="{Binding}"
                            IsEnabled="{Binding IsPaired, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource TogglePillStyle}" Background="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- 头部 -->
                <Grid Margin="4,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="音频控制中心" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Beta" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12" VerticalAlignment="Bottom" Margin="12,0,0,4" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="🔄 刷新" Click="Refresh_Click" Style="{StaticResource PillButtonStyle}"
                            Background="#33424750" Padding="12,7"/>
                </Grid>

                <!-- 全局默认设备 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="系统默认设备" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="输出" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,5"/>
                                <ComboBox Style="{StaticResource ComboStyle}" ItemsSource="{Binding RenderDevices}"
                                          SelectedItem="{Binding SelectedDefaultOutput, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="输入" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,5"/>
                                <ComboBox Style="{StaticResource ComboStyle}" ItemsSource="{Binding CaptureDevices}"
                                          SelectedItem="{Binding SelectedDefaultInput, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 蓝牙设备 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="蓝牙设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="最近连接优先 · 一键切换" Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{Binding ScanButtonText}" Click="Scan_Click"
                                        Style="{StaticResource PillButtonStyle}" Background="#33424750" Margin="0,0,8,0"/>
                                <Button Content="{Binding ShowAllButtonText}" Click="ShowAll_Click" Tag="{Binding}"
                                        Style="{StaticResource PillButtonStyle}" Background="#334A5E73"
                                        Visibility="{Binding ShowAllButtonVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 已配对设备（最近 3 个 / 全部） -->
                        <ItemsControl ItemsSource="{Binding VisibleBluetoothDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="BtTemplate"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="BtEmptyText" Text="未发现蓝牙音频设备（耳机/音箱）"
                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" Margin="4,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BluetoothDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 扫描结果 -->
                        <StackPanel x:Name="ScanPanel" Margin="0,10,0,0">
                            <Grid Margin="4,0,0,6">
                                <TextBlock Text="扫描附近设备（BLE）" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScanStatusText}" Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ScanResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="ScanTemplate"/>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="正在扫描… 让新设备进入配对模式即可发现" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12" Margin="4,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 应用音频 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="应用音频" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="每个应用独立选设备、独立音量 · 自动监测" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sessions}"
                                      ItemTemplate="{StaticResource SessionTemplate}"/>
                        <TextBlock x:Name="SessionEmptyText" Text="暂无正在使用声音的应用"
                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" Margin="4,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
