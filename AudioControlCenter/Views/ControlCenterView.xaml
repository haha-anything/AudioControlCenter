<UserControl x:Class="BTAudioSwitcher.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BTAudioSwitcher.Models"
             MinWidth="560">
    <UserControl.Resources>

        <!-- 设备列表数据源（供应用音频下拉使用 CompositeCollection） -->
        <CollectionViewSource x:Key="RenderDevicesCVS" Source="{Binding RenderDevices}"/>
        <CollectionViewSource x:Key="CaptureDevicesCVS" Source="{Binding CaptureDevices}"/>

        <!-- 设备项显示模板 -->
        <DataTemplate x:Key="DeviceItemTemplate" DataType="{x:Type models:AudioDeviceItem}">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
        </DataTemplate>

        <!-- 应用行卡片（系统音量合成器样式） -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:AppSessionItem}">
            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 行1：图标 + 名称 + 静音 + 音量滑块 + 百分比 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource ComboBgBrush}"
                                Margin="0,0,10,0">
                            <Image Width="26" Height="26" Stretch="Uniform">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource IconConverter}">
                                        <Binding Path="IconPath"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FollowStateText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="17"/>
                        </StackPanel>

                        <Button Grid.Column="2" Click="MuteButton_Click" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="静音/取消静音" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontSize="17">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔊"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Text" Value="🔇"/>
                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <Slider Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SliderStyle}"
                                    ValueChanged="SessionVolume_ValueChanged"
                                    Tag="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" Width="44" TextAlignment="Right"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 行2：输出/输入设备下拉 + 恢复默认 -->
                    <Grid Grid.Row="1" Margin="44,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="输出" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="0,0,0,4"/>
                            <ComboBox x:Name="OutputCombo" Style="{StaticResource ComboStyle}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectionChanged="SessionOutput_SelectionChanged"
                                      Tag="{Binding}" Loaded="SessionCombo_Loaded">
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="默认"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource RenderDevicesCVS}}"/>
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="输入" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="0,0,0,4"/>
                            <ComboBox x:Name="InputCombo" Style="{StaticResource ComboStyle}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectionChanged="SessionInput_SelectionChanged"
                                      Tag="{Binding}" Loaded="SessionCombo_Loaded">
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="默认"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource CaptureDevicesCVS}}"/>
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="3" Content="恢复默认" Click="ResetSession_Click" Tag="{Binding}"
                                Style="{StaticResource PillButtonStyle}" Background="{DynamicResource ComboBgBrush}"
                                VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 蓝牙设备卡片 -->
        <DataTemplate x:Key="BtTemplate" DataType="{x:Type models:BluetoothDeviceItem}">
            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,10,10" MinWidth="180">
                <StackPanel Width="180">
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17"/>
                        </StackPanel>
                        <Button Content="&#8943;" Click="MoreBt_Click" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextTertiaryBrush}"
                                FontSize="18" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"
                                ToolTip="备注品牌 / 设备信息"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding BrandIcon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BatteryText}" FontSize="17" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowBattery}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{Binding ConnectButtonText}" Click="BtToggle_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanToggle}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- BLE 扫描结果卡片 -->
        <DataTemplate x:Key="ScanTemplate" DataType="{x:Type models:ScanDeviceItem}">
            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,10,10" MinWidth="160">
                <StackPanel Width="160">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    <TextBlock Text="{Binding MacText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13" Margin="0,2,0,8"/>
                    <Button Content="{Binding PairButtonText}" Click="PairScan_Click" Tag="{Binding}"
                            IsEnabled="{Binding IsPaired, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PillButtonStyle}" Background="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- ============ 功能区 (0)：总览 + 系统设备 + 应用音频 + 蓝牙 融合 ============ -->
                <!-- ============ 功能区 (0)：蓝牙设备 + 系统设备 + 应用音频 ============ -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=0}">
                    <TextBlock Text="功能区" FontSize="24" FontWeight="Bold" Margin="2,0,0,16"/>

                    <!-- 蓝牙设备管理（已配对 + 扫描，置顶） -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="蓝牙设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding ScanButtonText}" Click="Scan_Click"
                                            Style="{StaticResource PillButtonStyle}" Background="{DynamicResource ComboBgBrush}" Margin="0,0,8,0"/>
                                    <Button Content="{Binding ShowAllButtonText}" Click="ShowAll_Click" Tag="{Binding}"
                                            Style="{StaticResource PillButtonStyle}" Background="{DynamicResource ComboBgBrush}"
                                            Visibility="{Binding ShowAllButtonVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding VisibleBluetoothDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="BtTemplate"/>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="BtEmptyText" Text="未发现蓝牙音频设备（耳机/音箱）"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="4,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BluetoothDevices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel x:Name="ScanPanel" Margin="0,12,0,0">
                                <Grid Margin="4,0,0,8">
                                    <TextBlock Text="扫描附近设备（BLE）" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ScanStatusText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="17" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ScanResults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="ScanTemplate"/>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="正在扫描… 让新设备进入配对模式即可发现" Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="17" Margin="4,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 系统默认设备（可切换：输出/输入下拉） -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="系统默认设备" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="输出" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17" Margin="0,0,0,6"/>
                                    <ComboBox Style="{StaticResource ComboStyle}" ItemsSource="{Binding RenderDevices}"
                                              SelectedItem="{Binding SelectedDefaultOutput, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource DeviceItemTemplate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="输入" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17" Margin="0,0,0,6"/>
                                    <ComboBox Style="{StaticResource ComboStyle}" ItemsSource="{Binding CaptureDevices}"
                                              SelectedItem="{Binding SelectedDefaultInput, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource DeviceItemTemplate}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 应用音频 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="应用音频" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="每个应用独立选设备、独立音量 · 自动监测" Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sessions}"
                                          ItemTemplate="{StaticResource SessionTemplate}"/>
                            <TextBlock x:Name="SessionEmptyText" Text="暂无正在使用声音的应用"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="4,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ============ 个性化区 (1)：主题 + 字号 + 最近设备数 + 快捷开关 ============ -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=1}">
                    <TextBlock Text="个性化区" FontSize="24" FontWeight="Bold" Margin="2,0,0,16"/>

                    <!-- 主题 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="主题" Style="{StaticResource SectionTitleStyle}"/>
                            <RadioButton x:Name="ThemeAuto" Content="跟随系统" Margin="0,4" Checked="ThemeMode_Changed"/>
                            <RadioButton x:Name="ThemeDark" Content="深色" Margin="0,4" Checked="ThemeMode_Changed"/>
                            <RadioButton x:Name="ThemeLight" Content="浅色" Margin="0,4" Checked="ThemeMode_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 显示设置 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="显示" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="界面字号" FontSize="17" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="120" SelectedItem="{Binding FontSize, Mode=TwoWay}"
                                          Style="{StaticResource ComboStyle}">
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">17</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">19</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">21</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Int32>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="功能区显示最近蓝牙设备数" FontSize="17" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="120" SelectedItem="{Binding RecentDevicesCount, Mode=TwoWay}"
                                          Style="{StaticResource ComboStyle}">
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">2</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">3</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">5</sys:Int32>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">6</sys:Int32>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 快捷开关 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="快捷开关" Style="{StaticResource SectionTitleStyle}"/>
                            <CheckBox Content="🚀 开机自启" IsChecked="{Binding Settings.AutoStart, Mode=TwoWay}" Margin="0,4" FontSize="17"/>
                            <CheckBox Content="🔋 低电量提醒" IsChecked="{Binding Settings.LowBatteryAlert, Mode=TwoWay}" Margin="0,4" FontSize="17"/>
                            <TextBlock Text="托盘：单击=控制中心面板，双击=主窗口，右键=功能菜单"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="2,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 设置区 (2) ============ -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=2}">
                    <TextBlock Text="设置区" FontSize="24" FontWeight="Bold" Margin="2,0,0,16"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="BT Audio Switcher · 托盘常驻，一键切换蓝牙与分应用音频"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17"/>
                            <TextBlock Text="版本 v1.1.0 · Win11 · 自包含免安装运行"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="17" Margin="0,6,0,0"/>
                            <Button Content="🔄 立即刷新" Click="Refresh_Click" Style="{StaticResource PillButtonStyle}"
                                    Background="{DynamicResource ComboBgBrush}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
