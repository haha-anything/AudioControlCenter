<Window x:Class="BTAudioSwitcher.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BTAudioSwitcher.Views"
        Title="BT Audio Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="680"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{StaticResource BgBrush}" CornerRadius="18" Margin="10"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <views:ControlCenterView/>
    </Border>
</Window>
