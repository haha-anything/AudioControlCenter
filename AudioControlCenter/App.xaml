<Application x:Class="AudioControlCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AudioControlCenter.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- 转换器 -->
        <conv:IconConverter x:Key="IconConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- 主题色（iOS 控制中心风格） -->
        <SolidColorBrush x:Key="BgBrush" Color="#F2202026"/>
        <SolidColorBrush x:Key="CardBrush" Color="#33282B32"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#3D30343E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0A5DC2"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8A8AD"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7C7C82"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2A2A2F"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9F0A"/>

        <!-- 卡片 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 小节标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,2,0,8"/>
        </Style>

        <!-- 主按钮（连接/断开） -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框（ComboBox） -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#22424750"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 音量滑块 -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- 开关切换按钮 -->
        <Style x:Key="TogglePillStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
